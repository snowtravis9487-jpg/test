# Copy this file to .env and fill in the values. Never commit .env.

# Supabase: Project → Connect → "Session pooler" connection string
# (use the Session pooler, not "Direct connection": Render has no IPv6).
DATABASE_URL=postgresql://postgres.xxxxxxxx:YOUR-DB-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Password for the first "admin" account. Only used when the database is empty.
ADMIN_PASSWORD=change-me-please
